{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    ':automergeAll',
    ':automergePr',
    ':semanticCommits',
    ':separateMultipleMajorReleases',
    ':separatePatchReleases',
    'docker:pinDigests',
    'helpers:pinGitHubActionDigestsToSemver',
    'preview:dockerCompose',
    'preview:buildkite',
    'replacements:all',
    'schedule:weekly',
    ':maintainLockFilesWeekly',
  ],
  rebaseWhen: 'conflicted',
  prConcurrentLimit: 5,
  prHourlyLimit: 0,
  major: {
    dependencyDashboardApproval: false,
  },
  addLabels: [
    'dependencies',
    '{{manager}}',
  ],
  internalChecksFilter: 'strict',
  cloneSubmodules: true,
  vulnerabilityAlerts: {
    enabled: true,
    // Security fixes must not wait for the weekly window.
    schedule: [],
    labels: [
      'security',
    ],
  },
  osvVulnerabilityAlerts: true,
  packageRules: [
    {
      matchManagers: [
        'cargo',
      ],
      rangeStrategy: 'replace',
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'elquentaro/devcontainer',
      ],
      pinDigests: false,
    },
    {
      description: 'Group Prost crates',
      matchManagers: ['cargo'],
      matchDatasources: ['crate'],
      matchPackageNames: ['prost**'],
      groupName: 'prost crates',
      groupSlug: 'prost',
    },
    {
      description: 'Group Tonic crates',
      matchManagers: ['cargo'],
      matchDatasources: ['crate'],
      matchPackageNames: ['tonic**'],
      groupName: 'tonic crates',
      groupSlug: 'tonic',
    },
    {
      description: 'Group Datafusion crates',
      matchManagers: ['cargo'],
      matchDatasources: ['crate'],
      matchPackageNames: ['datafusion**'],
      groupName: 'datafusion crates',
      groupSlug: 'datafusion',
    },
  ],
}
